	"authors": [
		"BobbyNooby"
	],
	"contact": {
		"homepage": "https://github.com/BobbyNooby/youonlylivetwice",
		"sources": "https://github.com/BobbyNooby/youonlylivetwice"
	},
	"license": "MIT",
	"icon": "assets/you-only-live-twice/icon.png",
	"environment": "server",
	"entrypoints": {
		"server": [
			"bobbynooby.dev.YouOnlyLiveTwice"
		]
	},
	"mixins": [
		"you-only-live-twice.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.13",
		"minecraft": "~1.21.5",
		"java": ">=21",
		"fabric-api": "*"
